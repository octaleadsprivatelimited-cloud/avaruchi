# Add these directly to Hostinger's environment variables. Never commit real keys.
# Start in demonstration mode. Turn it off only after the business/catalog setup.
DEMO_MODE=true
DEMO_ADMIN_ENABLED=false
# Optional private demo administrator. Exact user ID shown on the preview account page.
ADMIN_DEMO_USER_ID=
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
SITE_URL=https://YOUR-TEMPORARY-HOSTINGER-DOMAIN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly one Google subject ID. Configuring it disables preview administrator access.
ADMIN_GOOGLE_SUB=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
INVOICE_FROM_EMAIL=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
GSTIN=
CATALOG_APPROVED=false
COD_ENABLED=true
SHIPPING_FEE=5900
FREE_SHIPPING_THRESHOLD=69900

# Enable providers only after verified live configuration. Server-only credentials.
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Generate a unique random token of at least 32 characters for x-api-key courier webhooks.
SHIPROCKET_WEBHOOK_TOKEN=
RAZORPAY_REFUNDS_ENABLED=false
# Random token of at least 32 characters for POST /api/jobs/invoices.
CRON_SECRET=
