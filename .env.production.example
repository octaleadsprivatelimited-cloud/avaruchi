# Set these in the hosting environment; this template contains no live credentials.
NODE_ENV=production
USE_DATABASE=true
APP_URL=https://your-avaruchi-domain.example
VITE_PUBLIC_SITE_URL=https://your-avaruchi-domain.example
DATABASE_HOST=your-mysql-host.example
DATABASE_PORT=3306
DATABASE_USER=avaruchi
DATABASE_PASSWORD=replace-with-your-hosted-database-password
DATABASE_NAME=avaruchi
JWT_SECRET=replace-with-a-unique-random-secret-at-least-64-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-64-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-a-stable-random-32-byte-key
CORS_ORIGINS=https://your-avaruchi-domain.example
PUBLIC_UPLOAD_BASE_URL=https://your-avaruchi-domain.example/uploads
# Set UPLOAD_DIR to a durable writable directory outside the deployment checkout.
# UPLOAD_DIR=/absolute/path/to/avaruchi/uploads
# Set TRUST_PROXY only for the hosting proxy topology you actually use.
TRUST_PROXY=
# Configure all Firebase values for Avaruchi's own project before enabling sign-in.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
STORE_ADMIN_EMAIL=
# Keep the new store empty. Enable only to deliberately load sample products/coupons.
SEED_CATALOG=false
# Production browser API requests share APP_URL. Keep this empty.
VITE_COMMERCE_API_URL=
# Configure payment, shipping and email providers in Admin after verified sign-in.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=LIVE
