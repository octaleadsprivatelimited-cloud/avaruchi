{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": "vite",
  "buildCommand": "VITE_COMMERCE_API_URL= pnpm build:hostinger",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".output/public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{.output/**,commerce-api/dist/bundle/**,commerce-api/prisma/**}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/api/index.mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.mjs"
    }
  ]
}
